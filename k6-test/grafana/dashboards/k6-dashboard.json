  "annotations": {
    "list": [
      {
        "name": "🚨 좌석 예약 응답시간 5초 초과",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "histogram_quantile(0.95, sum(rate(k6_seat_reservation_duration[30s])) by (le)) > 5000",
        "iconColor": "red",
        "titleFormat": "좌석 예약 P95 응답시간이 5초 초과!"
      },
      {
        "name": "⚠️ WebSocket 연결 실패율 5% 초과",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "avg(k6_checks_rate{check=\"WebSocket 핸드셰이크 성공\"}) < 0.95",
        "iconColor": "orange",
        "titleFormat": "WebSocket 연결 실패율 5% 초과"
      },
      {
        "name": "🎯 좌석 예약 성공률 60% 달성",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "(sum(k6_seat_reservation_success_total) / sum(k6_queue_entry_success_total)) * 100 > 60",
        "iconColor": "green",
        "titleFormat": "좌석 예약 성공률 60% 달성!"
      }
    ]
  }
}